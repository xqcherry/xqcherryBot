DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=3001
COMMAND_START=["/", ""]

# ==================== 数据库迁移工具配置 ====================
DB_MIGRATION_DIR="/app/nonebot/migrations"
DB_OUTPUT_PATH="/app/db/bot_data.db"

# ================= 全局访问控制插件配置 =================
