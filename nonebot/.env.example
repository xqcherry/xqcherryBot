ACCESS_CONTROL_BLACK_USERS=[]
ACCESS_CONTROL_BLACK_GROUPS=[1017750994, 1034817756, 913914054]
ACCESS_CONTROL_WHITE_USERS=[2059928821, 2417185282, 2683361634]
ACCESS_CONTROL_WHITE_GROUPS=[]

# ==================== pngSender 插件配置 ====================
LOCAL_TAILSCALE_IP="100.112.64.94"
LOCAL_PORT="39425"
WHITELIST_QQ=[2417185282, 2303866129]

# ==================== agent_bridge 配置 ============================
AGENT_GATEWAY_URL=ws://127.0.0.1:8787
AGENT_AUTHOR_QQ=2417185282
AGENT_TRIGGER_PREFIX=#agent