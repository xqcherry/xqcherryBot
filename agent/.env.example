# Agent Gateway 部署环境配置
# 将此文件复制到服务器上的 .env 并填写真实的密钥信息

# OpenAI 兼容的模型端点
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-openai-compatible-api-key
OPENAI_MODEL=deepseek-v4-flash

# 可选参数。省略时将默认使用 OPENAI_MODEL
AGENT_SUMMARY_MODEL=deepseek-v4-flash

# Gateway WebSocket 监听地址
# 当 NoneBot 运行在同一台服务器上时，使用 127.0.0.1
# 仅在防火墙/反向代理/VPN 之后使用 0.0.0.0；该 gateway 尚未实现认证机制
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8787

# 持久化 SQLite 数据库路径
AGENT_GATEWAY_DB=../db/agent-gateway.sqlite