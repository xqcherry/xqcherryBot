# Agent Gateway 部署环境配置
# 将此文件复制到服务器上的 .env 文件，并填写真实的密钥信息

# 模型提供商。运行时拥有提供商工厂；openai-compatible 是当前实现的适配器。
# 原生 anthropic/gemini 适配器保留供后续使用。
AGENT_MODEL_PROVIDER=openai-compatible

# 可选。默认值为 AGENT_MODEL_PROVIDER。当前仅实现了 openai-compatible/openai。
# 用于区分未来的对话压缩提供商与对话模型。
AGENT_COMPACTION_PROVIDER=openai-compatible

# OpenAI 兼容模型端点
# 真实的密钥请仅保存在 .env 或进程管理器的密钥存储中
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_MODEL=deepseek-v4-flash

# 可选。省略时默认使用 OPENAI_MODEL 的值
AGENT_SUMMARY_MODEL=deepseek-v4-flash

# 对话上下文和轮次控制
AGENT_RECENT_MESSAGE_LIMIT=20
AGENT_UNCOMPACTED_MESSAGE_LIMIT=80
AGENT_SENDER_CONTEXT_LIMIT=6
AGENT_TURN_TIMEOUT_MS=120000

# 基于 Token 的上下文压缩。除非设置了提供商/模型特定的覆盖值，否则使用通用上下文窗口大小。
# 提供商/模型的键名会被转换为大写，非字母数字字符替换为下划线
AGENT_MODEL_CONTEXT_WINDOW=128000
# AGENT_MODEL_CONTEXT_WINDOW_OPENAI_COMPATIBLE_DEEPSEEK_V4_FLASH=131072
AGENT_COMPACTION_THRESHOLD_RATIO=0.55
AGENT_COMPACTION_SAFETY_RATIO=0.85
AGENT_COMPACTION_RESERVED_OUTPUT_TOKENS=4096
AGENT_COMPACTION_RECENT_TAIL_TOKEN_BUDGET=12000
# 摘要格式：markdown 是稳定的默认格式；json 启用模式验证
AGENT_COMPACTION_FORMAT=markdown
# 可选：更严格的摘要质量检查。启用后，会拒绝丢弃活跃请求、用户偏好或未解决问题的摘要，且不会持久化
AGENT_COMPACTION_QUALITY_CHECK=false

# 可选：逗号分隔的模型工具允许列表
# 留空则暴露所有内置对话工具
# 当前内置工具：get_recent_messages, get_active_memories, propose_memory_candidate
# AGENT_ALLOWED_TOOLS=get_recent_messages,get_active_memories,propose_memory_candidate

# Gateway WebSocket 监听地址
# 当 NoneBot 运行在同一服务器时使用 127.0.0.1
# 仅在防火墙/反向代理/VPN 后方使用 0.0.0.0；该 Gateway 当前没有身份验证
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8787

# 会话存储提供商。当前已实现 SQLite；运行时会保持提供商特定的适配器隔离，以便后续增加 MySQL/PostgreSQL
AGENT_SESSION_STORE=sqlite

# 持久化 SQLite 数据库路径。AGENT_GATEWAY_DB 为保持向后兼容仍然支持。
# 你也可以使用 AGENT_DATABASE_URL=sqlite:./data/agent-gateway.sqlite
AGENT_GATEWAY_DB=./data/agent-gateway.sqlite
# AGENT_DATABASE_URL=sqlite:./data/agent-gateway.sqlite

# 提示词回退模式。warn 会记录提示词回退事件并继续使用内置的 CHAT_PERSONA 提示词；
# fail 会在 CHAT_PERSONA 未导入到 SQLite 或其 systemPrompt 为空时拒绝启动
AGENT_PROMPT_FALLBACK_MODE=warn

# NoneBot 桥接设置，用于你自己的 NoneBot 插件/配置
AGENT_GATEWAY_URL=ws://127.0.0.1:8787
AGENT_AUTHOR_QQ=123456789